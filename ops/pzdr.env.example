# Copy to /etc/pzdr/pzdr.env on the EC2 parent instance.

PROXY_ADDR=0.0.0.0:8090
ENCLAVE_CID=16
ENCLAVE_PORT=5000
ENCLAVE_TIMEOUT_MS=30000
RUST_LOG=info

PZDR_EIF_PATH=/opt/pzdr/eif/pzdr-enclave-v0.1.0.eif
PZDR_ENCLAVE_MEMORY_MIB=2048
PZDR_ENCLAVE_CPU_COUNT=2
PZDR_EXPECTED_PCR0=replace-with-final-pcr0-imagesha384

# Filled after AWS Marketplace SaaS product creation.
AWS_MARKETPLACE_PRODUCT_CODE=
PZDR_METERING_SPOOL=/var/lib/pzdr/metering/events.jsonl
